# ====================================================================
# Telegram All-in-One Media Downloader Bot Configuration
# ====================================================================

# Bot API Token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (Optional) Comma-separated list of Telegram User IDs allowed to use the bot.
# Leave blank to allow anyone who messages the bot.
# Example: ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# ====================================================================
# Telegram Local Bot API Server (Unlocks 2,000 MB / 2 GB Uploads)
# ====================================================================
# Your Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Leave blank to use standard Telegram Cloud API (50 MB limit).
# If running a local Bot API server (e.g., via Docker), set to:
# LOCAL_BOT_API_URL=http://localhost:8081
LOCAL_BOT_API_URL=http://localhost:8081

# Set to true if the bot and local server share filesystem access for instant zero-copy delivery
LOCAL_BOT_API_LOCAL_MODE=false

# Maximum upload limit in Megabytes (Defaults to 2000 MB if LOCAL_BOT_API_URL is set, 50 MB otherwise)
# MAX_FILE_SIZE_MB=2000
MAX_FILE_SIZE_MB=

# Auto-split oversized videos into seamless parts with zero quality loss
AUTO_SPLIT_OVERSIZED_VIDEOS=true

# ====================================================================
# Platform Authentication & Cookies (Optional)
# ====================================================================
# Netscape cookies or Base64 string for YouTube / Instagram / TeraBox
# (You can also upload cookies.txt directly to the bot in chat via /cookies)
# COOKIES_CONTENT=
# TeraBox session cookie (ndus) from terabox.com (Inspect -> Application -> Cookies -> ndus)
# TERABOX_COOKIE=

# Optional DiskWala extraction API key and custom resolver URL (e.g. from developer API portals)
# DISKWALA_API_KEY=
# DISKWALA_API_URL=

# ====================================================================
# Promotional Channels (Non-forced output recommendation buttons)
# ====================================================================
PROMO_CHANNELS_ENABLED=true
MOD_APK_CHANNEL=ModRepository
WALLPAPER_CHANNEL=WallpapersRepository

