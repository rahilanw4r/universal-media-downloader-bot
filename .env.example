# ====================================================================
# Telegram All-in-One Media Downloader Bot Configuration
# ====================================================================

# Bot API Token from @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# (Optional) Comma-separated list of Telegram User IDs allowed to use the bot.
# Leave blank to allow anyone who messages the bot.
# Example: ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=
